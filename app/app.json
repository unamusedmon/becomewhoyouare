{
  "expo": {
    "name": "Become Who You Are",
    "slug": "become-who-you-are",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0E0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.unamusedmon.becomewhoyouare"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "backgroundColor": "#0F0E0D",
    "scheme": "becomewhoyouare",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D9A441"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lets you say tasks out loud instead of typing them.",
          "speechRecognitionPermission": "Turns what you say into tasks."
        }
      ]
    ]
  }
}
